# D Database server environment template
# Copy to .env locally. Never commit the real .env file.

NODE_ENV=development

# D Database PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=d_database
DB_USER=d_database_app
# Optional PostgreSQL pool tuning (defaults are safe for local development).
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_POOL_MAX_LIFETIME_SECONDS=1800
# DB_APPLICATION_NAME=dsquare-d-database
# Base64-encoded database password; replace with your own value.
DB_PASSWORD_BASE64=REPLACE_WITH_BASE64_ENCODED_PASSWORD

# D Database frontend origin (must be an origin, with no path)
D_DATABASE_APP_ORIGIN=http://127.0.0.1:5173

# D Hosting integration
D_HOSTING_INTEGRATION_CLIENT_ID=dsquare-d-hosting
# Generate a strong random secret and use the SAME value in both server .env files.
D_HOSTING_INTEGRATION_CLIENT_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET
# Exact callback origin and path used by the D Hosting frontend.
D_HOSTING_CALLBACK_URL=http://127.0.0.1:5174/integrations/database/callback

# Optional separate PostgreSQL provisioner connection. Never use DB_USER for role creation.
# Configure only on the trusted D Database server. A DBA must create this dedicated role
# with CREATEROLE, NOINHERIT, membership in d_database_app (SET ROLE only, for default
# privileges), and pg_signal_backend (to terminate sessions on revocation).
# Keep this URL private and do not expose it to D Hosting or the frontend.
# DB_PROVISIONER_URL=postgresql://d_database_provisioner:REPLACE_ME@127.0.0.1:5432/d_database

# Optional durable backup storage (S3-compatible, e.g. Cloudflare R2).
# Leave all required values unset to keep backup operations disabled.
# Use a private bucket and a key restricted to this product's backup prefix.
# D_DATABASE_BACKUP_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# D_DATABASE_BACKUP_REGION=auto
# D_DATABASE_BACKUP_BUCKET=dsquare-database-backups
# D_DATABASE_BACKUP_ACCESS_KEY_ID=REPLACE_WITH_STORAGE_ACCESS_KEY
# D_DATABASE_BACKUP_SECRET_ACCESS_KEY=REPLACE_WITH_STORAGE_SECRET
# D_DATABASE_BACKUP_PREFIX=dsquare-d-database
# Optional automatic backup worker. Keep disabled until the bucket and PostgreSQL client tools are configured.
# D_DATABASE_BACKUP_SCHEDULER_ENABLED=false
# D_DATABASE_BACKUP_INTERVAL_MS=86400000
# D_DATABASE_BACKUP_RETENTION_DAYS=30
# PG_DUMP_PATH=pg_dump
# PG_RESTORE_PATH=pg_restore
