# Configure these values only on a dedicated Linux runtime-agent host.
# Generate a unique secret with: openssl rand -hex 32
RUNTIME_AGENT_SHARED_SECRET=replace-with-at-least-64-random-hex-characters

# Use a dedicated PostgreSQL database and least-privilege agent role.
RUNTIME_AGENT_DATABASE_URL=postgresql://runtime_agent_user:replace-me@127.0.0.1:5432/dsquare_runtime_agent
RUNTIME_AGENT_DB_SSL=false

# Private storage outside any web-served directory.
RUNTIME_AGENT_STORAGE_ROOT=/var/lib/dsquare-hosting-agent/artifacts

# Podman must run on the dedicated Linux host. Both runtime roots must refer
# to the same shared host directory as seen by the agent and Podman service.
RUNTIME_AGENT_PODMAN_SOCKET=/run/podman/podman.sock
RUNTIME_AGENT_TRUSTED_IMAGE=node:22-bookworm-slim
RUNTIME_AGENT_PODMAN_NETWORK=dsquare-private
RUNTIME_AGENT_RUNTIME_ROOT=/var/lib/dsquare-hosting-agent/runtime-workspaces
RUNTIME_AGENT_CONTAINER_RUNTIME_ROOT=/var/lib/dsquare-hosting-agent/runtime-workspaces

RUNTIME_AGENT_HOST=127.0.0.1
RUNTIME_AGENT_PORT=5003

# Isolated Node builder (keep disabled until the dedicated Linux host is ready).
# Enforce an outbound firewall policy that permits only approved npm registry/CDN
# endpoints before setting the egress acknowledgement to true.
RUNTIME_AGENT_BUILDER_ENABLED=false
RUNTIME_AGENT_NPM_REGISTRY_EGRESS_RESTRICTED=false
RUNTIME_AGENT_BUILDER_CACHE_SIGNING_KEY=replace-with-a-separate-random-secret-of-at-least-32-bytes
RUNTIME_AGENT_BUILDER_WORKSPACE_ROOT=/var/lib/dsquare-hosting-agent/build-workspaces
RUNTIME_AGENT_NPM_CACHE_ROOT=/var/lib/dsquare-hosting-agent/npm-cache

# Corresponding paths as visible inside the Podman service.
RUNTIME_AGENT_CONTAINER_STORAGE_ROOT=/var/lib/dsquare-hosting-agent/artifacts
RUNTIME_AGENT_CONTAINER_BUILDER_WORKSPACE_ROOT=/var/lib/dsquare-hosting-agent/build-workspaces
RUNTIME_AGENT_CONTAINER_NPM_CACHE_ROOT=/var/lib/dsquare-hosting-agent/npm-cache

# Caddy private ingress admin API. Run Caddy on the same dedicated Linux host.
# Caddy listens on 0.0.0.0:2019 INSIDE its container so the published port works.
# Publish ONLY as 127.0.0.1:2019:2019 on the host; never expose this port publicly.
# Put Caddy and deployment containers on the same private Podman network.
RUNTIME_AGENT_CADDY_ADMIN_URL=http://127.0.0.1:2019/
