# D Hosting server environment template
# Copy to .env locally. Never commit the real .env file.

NODE_ENV=development

# D Hosting application database connection (least-privilege role)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=d_hosting
DB_USER=d_hosting_app
# Optional PostgreSQL pool tuning (defaults are safe for local development).
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_POOL_MAX_LIFETIME_SECONDS=1800
# DB_APPLICATION_NAME=dsquare-d-hosting
# Base64-encoded application database password; replace with your own value.
DB_PASSWORD_BASE64=REPLACE_WITH_BASE64_ENCODED_PASSWORD

# Optional dedicated schema-owner connection used only while applying migrations.
# Prefer this over giving the application role table ownership or elevated privileges.
# You may use a connection URL, or the separate DB_MIGRATION_* fields below.
# DB_MIGRATION_URL=postgresql://SCHEMA_OWNER:URL_ENCODED_PASSWORD@127.0.0.1:5432/d_hosting
# DB_MIGRATION_HOST=127.0.0.1
# DB_MIGRATION_PORT=5432
# DB_MIGRATION_NAME=d_hosting
# DB_MIGRATION_USER=postgres
# DB_MIGRATION_PASSWORD_BASE64=REPLACE_WITH_BASE64_ENCODED_SCHEMA_OWNER_PASSWORD
# DB_MIGRATION_SSL=false
# DB_MIGRATION_POOL_MAX=2
# If no dedicated migration credentials are configured, migrations use DB_USER.

# Encryption key for D Hosting environment-variable secrets (required before saving secrets).
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key private, stable, and backed up securely. Losing it makes saved secrets undecryptable.
HOSTING_SECRETS_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# D Hosting frontend origin (must be an origin, with no path)
D_HOSTING_APP_ORIGIN=http://127.0.0.1:5174

# D Database integration
D_HOSTING_INTEGRATION_CLIENT_ID=dsquare-d-hosting
# Generate a strong random secret and use the SAME value in both server .env files.
D_HOSTING_INTEGRATION_CLIENT_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET
D_DATABASE_API_URL=http://127.0.0.1:5001
D_DATABASE_APP_URL=http://127.0.0.1:5173

# Private D Hosting Runtime Agent (dedicated Linux host only; never expose Podman socket).
# Keep customer code execution disabled until Linux isolation acceptance is complete.
# D_HOSTING_RUNTIME_AGENT_URL=https://PRIVATE_RUNTIME_AGENT_INTERNAL_ORIGIN
# D_HOSTING_RUNTIME_AGENT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Optional ACME contact email for automatic HTTPS on verified Node custom domains.
# The private Runtime Agent must have RUNTIME_AGENT_CADDY_ADMIN_URL configured.
# D_HOSTING_TLS_EMAIL=ops@example.com
