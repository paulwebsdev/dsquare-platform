# D Hosting server environment template
# Copy to .env locally. Never commit the real .env file.

NODE_ENV=development

# D Hosting PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=d_hosting
DB_USER=d_hosting_app
# Optional PostgreSQL pool tuning (defaults are safe for local development).
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_POOL_MAX_LIFETIME_SECONDS=1800
# DB_APPLICATION_NAME=dsquare-d-hosting
# Base64-encoded database password; replace with your own value.
DB_PASSWORD_BASE64=REPLACE_WITH_BASE64_ENCODED_PASSWORD

# D Hosting frontend origin (must be an origin, with no path)
D_HOSTING_APP_ORIGIN=http://127.0.0.1:5174

# D Database integration
D_HOSTING_INTEGRATION_CLIENT_ID=dsquare-d-hosting
# Generate a strong random secret and use the SAME value in both server .env files.
D_HOSTING_INTEGRATION_CLIENT_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET
D_DATABASE_API_URL=http://127.0.0.1:5001
D_DATABASE_APP_URL=http://127.0.0.1:5173
